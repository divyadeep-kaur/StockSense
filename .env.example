# SQLite database file used by Prisma
DATABASE_URL="file:./dev.db"

# Used to sign session cookies. Set a long random value in production.
JWT_SECRET="dev-secret-change-me"

# Required to actually deliver password-reset OTP emails (see README > Password Reset).
# Get a free key at https://resend.com/api-keys — leave blank and OTPs are
# only logged to the server console (dev-only fallback, not for the demo).
RESEND_API_KEY=your_resend_api_key
# Must be onboarding@resend.dev (Resend's shared sandbox sender) unless you've
# verified your own domain in Resend. See README for details.
EMAIL_FROM="StockSense <onboarding@resend.dev>"

# Required for the AI assistant. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
