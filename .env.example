# SQLite database file used by Prisma
DATABASE_URL="file:./dev.db"

# Used to sign session cookies. Set a long random value in production.
JWT_SECRET="dev-secret-change-me"

# Optional: SMTP for sending password-reset emails.
# Leave SMTP_HOST blank in development — OTP codes are logged to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StockSense <no-reply@stocksense.local>"

# Required for the AI assistant. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
